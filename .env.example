# Copiar a .env y llenar con valores reales. .env está en .gitignore — nunca
# commitear claves reales.

# Requerida para el módulo de noticias (clasificación de sentimiento).
ANTHROPIC_API_KEY=

# Opcionales — si se omiten, esas fuentes se desactivan solas (sin error).
NEWSDATA_API_KEY=
COINMARKETCAL_API_KEY=

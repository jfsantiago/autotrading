# Copiar a .env y llenar con valores reales. .env está en .gitignore — nunca
# commitear claves reales.

# Requerida para el módulo de noticias (clasificación de sentimiento).
OPENAI_API_KEY=

# Opcionales — si se omiten, esas fuentes se desactivan solas (sin error).
NEWSDATA_API_KEY=
COINMARKETCAL_API_KEY=

# Claves del Futures TESTNET de Binance (dinero ficticio) — se obtienen en
# https://testnet.binancefuture.com/, con un registro SEPARADO de tu cuenta
# real de Binance y del Spot Testnet (testnet.binance.vision, que usa login
# de GitHub). Solo son necesarias para el comando `trade`; `decide`/`news`/
# `backtest` no las requieren.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

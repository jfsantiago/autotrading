# Copiar a .env y llenar con valores reales. .env está en .gitignore — nunca
# commitear claves reales.

# Requerida para el módulo de noticias (clasificación de sentimiento).
OPENAI_API_KEY=

# Requerida junto con OPENAI_API_KEY — connection string de Postgres de
# Supabase (Project Settings -> Database -> Connection string -> usar el
# modo "Transaction pooler", puerto 6543, recomendado para conexiones cortas
# como esta). Sin esto no hay caché permanente de clasificaciones LLM entre
# ejecuciones (ver news/cache.py) ni estado del scheduler (ver scheduling.py)
# — correr antes supabase/schema.sql una vez en el SQL editor de Supabase.
SUPABASE_DB_URL=

# Opcionales — si se omiten, esas fuentes se desactivan solas (sin error).
NEWSDATA_API_KEY=
COINMARKETCAL_API_KEY=

# Claves de Binance Demo Trading (dinero ficticio) — se obtienen en
# https://demo.binance.com/en/my/settings/api-management. Binance retiró el
# viejo "Futures Testnet" (testnet.binancefuture.com) — esas claves viejas
# NO funcionan aquí, tienen que ser generadas en demo.binance.com. Solo son
# necesarias para el comando `trade`; `decide`/`news`/`backtest` no las
# requieren.
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# Opcionales — sobrescriben los valores de configs/default.yaml sin tener que
# editar el YAML. Pensado como el primer paso hacia el control por Telegram
# (el bot futuro podría setear estas variables en caliente). Si se omiten, se
# usa lo que diga el YAML. Ambas tienen un techo de seguridad hardcodeado en
# el código (no configurable) independiente de este valor.
AUTOTRADING_POSITION_SIZE_PCT=
AUTOTRADING_LEVERAGE=

# Bot de Telegram (solo lectura: posiciones + historial de P&L). Token vía
# @BotFather (crear uno nuevo); CHAT_ID es tu ID numérico de Telegram
# (pedírselo a @userinfobot una vez). El bot ignora silenciosamente a
# cualquier chat_id que no sea este — control de acceso no opcional. Solo
# necesarias para el comando `telegram-bot`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
